# TRIAGE environment template. Copy to `.env`.
#
# ---------------------------------------------------------------------------
# PROFILE A - ALL LLMs LOCAL VIA OLLAMA, ZERO LLM API KEYS (default below)
# ---------------------------------------------------------------------------
#   generator : ollama llama3.1:8b-instruct-q4_K_M  (4-bit, ~4.9 GB VRAM)
#   judge     : picked by index from src/judge_models.py, 4-bit (q4_K_M)
#
# Everything ELSE keeps its existing behavior: keep your other keys
# (WANDB_API_KEY => telemetry stays online, TYPESAFE_API_KEY => live JEV
# gate, NVIDIA_API_KEY => NIM fallback provider, HF_TOKEN => hub auth) -
# this profile only changes where the generator and judge run.
#
# Prereqs: ollama pull llama3.1:8b-instruct-q4_K_M && ollama pull <judge tag>
# (the Kaggle notebook pulls exactly the tags src/ resolves)
#
LLM_PROVIDER=ollama
JUDGE_OLLAMA_MODEL=qwen2.5:14b
# Multi-Judge Panel: comma-separated list of judges for ensemble evaluation
JUDGE_PANEL=qwen2.5:14b,gemma2:9b
HCAD_MULTI_JUDGE=0

# ---------------------------------------------------------------------------
# JUDGE SELECTION BY REGISTRY INDEX (src/judge_models.py)
# ---------------------------------------------------------------------------
#   0 Qwen3-14B   1 DeepSeek-R1-Distill-Qwen-14B   2 Gemma 3 12B IT
#   3 Qwen2.5-14B-Instruct   4 Phi-4 14B   5 Gemma 2 9B IT
# One index = one judge; "0,3" = two-judge consensus panel.
JUDGE_MODEL_INDEX=3
JUDGE_QUANT=q4_K_M              # 4-bit for every judge (q3_K_M/qat/q8_0/fp16 exist for some)
# JUDGE_NUM_CTX=8192            # judge context window
# JUDGE_MAX_FAILURE_RATE=0.5    # abort when a judge fails more than this share of evaluations
# JUDGE_SKIP_PREFLIGHT=1        # skip the "is the judge pulled and answering" check

# ---------------------------------------------------------------------------
# PROFILE B - OPTIONAL CLOUD-JUDGE UPGRADE (uncomment to switch)
# ---------------------------------------------------------------------------
# JUDGE_PROVIDER=huggingface    # judge => Qwen/Qwen2.5-72B-Instruct (HF cloud,
#                               # pay-per-token ~$2 per 50-sample run; paper parity)
#                               # requires HF_TOKEN + HF Inference Providers billing
# JUDGE_PROVIDER=nvidia         # ...or judge via NVIDIA NIM instead

# ---------------------------------------------------------------------------
# UNRELATED KNOBS (keep as-is unless you want to change them)
# ---------------------------------------------------------------------------
# WANDB_API_KEY=...             # set => W&B online (recommended)
# WANDB_MODE=disabled           # only if you want telemetry fully local
# TYPESAFE_API_KEY=...          # set => live JEV System One gate; omit => local calibrated mode
# NVIDIA_API_KEY=...            # NIM fallback if ollama is unavailable
# WANDB_PROJECT=hcad-rag

# Model overrides (defaults are sensible):
# LLM_NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# JUDGE_NVIDIA_MODEL=qwen/qwen2.5-72b-instruct

# ---------------------------------------------------------------------------
# MULTI-JUDGE EVALUATION (advisor directive; replaces the single judge)
# ---------------------------------------------------------------------------
# Explicit comma list of provider:model judges (first = primary). Overrides
# JUDGE_MODEL_INDEX when set. Judges are strict: a missing key/model is an
# error, never a silent swap. With neither set, the default panel is
# ollama:gemma2:9b-instruct-q4_K_M,ollama:qwen2.5:14b-instruct-q4_K_M.
# JUDGE_ENSEMBLE=ollama:gemma2:9b-instruct-q4_K_M,ollama:qwen2.5:14b-instruct-q4_K_M
# Optional third (API) judge: Llama-3.3-70B-Instruct via NVIDIA NIM
# (needs NVIDIA_API_KEY). Fleiss' kappa is reported over all judges.
# JUDGE_ENABLE_API_JUDGE=1

# ---------------------------------------------------------------------------
# BENCHMARK ARMS, ABLATIONS, STATISTICS, LATENCY, POLARITY
# ---------------------------------------------------------------------------
# Arms: closed_book (Llama-3.1-8B-Instruct, Zero-Retrieval / Closed-Book),
#       bm25, dense (S-PubMedBERT top-5), hybrid (BM25+dense RRF), hcad
# BENCHMARK_ARMS=closed_book,bm25,dense,hybrid,hcad
# BENCHMARK_ABLATIONS=1         # + w/o Decoupling, w/o Soft Gram-Schmidt, w/o Decision Gate
# BOOTSTRAP_RESAMPLES=10000     # bootstrap 95% CIs
# LATENCY_TIMED_RUNS=3          # warm retrieval-only timing runs per question (+1 cold run)
# POLARITY_TOP_K=5              # k for Polarity_Recall@k
#
# Single-component ablation toggles (set automatically per ablation arm;
# only set by hand for one-off experiments):
# HCAD_DENSE_WEIGHT=1.0         # w/o Decoupling   (Phi = dense cosine only)
# HCAD_ORTHO_STRENGTH=0.0       # w/o Soft Gram-Schmidt (eta = 0)
# HCAD_DECISION_GATE=0          # w/o Decision Gate
#
# HCAD evidence assembly (defaults shown; see README "Evidence assembly"):
# HCAD_DENSE_ANCHOR_K=1         # best full-text passage always admitted (0 = legacy)
# HCAD_DENSE_ANCHOR_MIN=0.40    # cosine floor for the dense anchor
# HCAD_GROUP_FACTS=1            # one evidence line per (head, relation) hyperedge
